# Copy this file to .env and fill in your Yapily credentials.
# NEVER commit .env or send your Application Secret in chat.
YAPILY_APPLICATION_ID=YOUR_APPLICATION_ID
YAPILY_APPLICATION_SECRET=YOUR_APPLICATION_SECRET

# Use the same callback URL that you register in Yapily Console.
# For deployment, use your own HTTPS Render/Railway/etc. URL.
CALLBACK_URL=https://YOUR-APP-DOMAIN.example.com/callback

# Your lab's sandbox institution and application user.
INSTITUTION_ID=modelo-sandbox
APPLICATION_USER_ID=student-001

PORT=3000
YAPILY_BASE_URL=https://api.yapily.com
